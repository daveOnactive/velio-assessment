{
  "name": "velio-group-booking",
  "private": true,
  "workspaces": ["backend", "web"],
  "scripts": {
    "dev:api": "npm run dev --workspace @velio/api",
    "dev:web": "npm run dev --workspace @velio/web",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspace @velio/api",
    "db:seed": "npm run seed --workspace @velio/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck --workspaces",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build"
  },
  "devDependencies": {"@eslint/js":"^9.19.0","@typescript-eslint/eslint-plugin":"^8.22.0","@typescript-eslint/parser":"^8.22.0","eslint":"^9.19.0","eslint-config-prettier":"^10.0.1","eslint-plugin-import":"^2.31.0","eslint-plugin-jsx-a11y":"^6.10.2","eslint-plugin-react-hooks":"^5.1.0","eslint-plugin-react-refresh":"^0.4.18","globals":"^15.14.0","prettier":"^3.5.0","typescript-eslint":"^8.22.0"}
}
